# UID пользователя внутри Airflow-контейнеров
AIRFLOW_UID=50000

# GID может оставаться 0 (root), это нормальный вариант
AIRFLOW_GID=0

# Папка с данными Airflow (пусть переменная есть, даже если не используешь)
AIRFLOW_HOME=/opt/airflow

# Явно зададим окружение для Postgres (часто требуется)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Время и язык
TZ=Europe/Warsaw
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
